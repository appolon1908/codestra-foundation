FOUNDATION_ENVIRONMENT=development
FOUNDATION_DATABASE_URL=postgresql+psycopg://foundation:{password}@postgres:5432/foundation
FOUNDATION_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
FOUNDATION_MUTATIONS_ENABLED=false
FOUNDATION_AUTO_CREATE_SCHEMA=false
FOUNDATION_JWT_ISSUER=https://auth.codestra.co/realms/codestra
FOUNDATION_JWT_AUDIENCE=codestra-foundation-api
FOUNDATION_JWT_ALGORITHM=RS256
FOUNDATION_JWT_PUBLIC_KEY_FILE=/run/secrets/foundation_jwt_public_key
FOUNDATION_FIELD_ENCRYPTION_KEY_FILE=/run/secrets/foundation_field_encryption_key
FOUNDATION_IDENTITY_HASH_KEY_FILE=/run/secrets/foundation_identity_hash_key
FOUNDATION_OUTBOX_ENABLED=false
FOUNDATION_MIDDLEWARE_EVENT_URL=https://middleware.internal.example/v1/events
FOUNDATION_MIDDLEWARE_ACCESS_TOKEN_FILE=/run/secrets/middleware_access_token
FOUNDATION_MIDDLEWARE_CA_FILE=/run/secrets/middleware_ca
FOUNDATION_MIDDLEWARE_CLIENT_CERT_FILE=/run/secrets/middleware_client_cert
FOUNDATION_MIDDLEWARE_CLIENT_KEY_FILE=/run/secrets/middleware_client_key
